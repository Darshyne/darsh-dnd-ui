{
  "id": "darsh-dnd-ui",
  "title": "DAS · Combat UI",
  "description": "A Baldur's Gate 3-style combat UI for dnd5e: action bar, party portraits, initiative strip. Built on the dnd5e-combat engine (turn budget, movement, reasons why actions are greyed out).",
  "version": "0.17.0",
  "authors": [
    {
      "name": "Darshyne"
    }
  ],
  "url": "https://github.com/Darshyne/darsh-dnd-ui",
  "license": "https://github.com/Darshyne/darsh-dnd-ui/blob/main/LICENSE",
  "manifest": "https://github.com/Darshyne/darsh-dnd-ui/releases/latest/download/module.json",
  "download": "https://github.com/Darshyne/darsh-dnd-ui/releases/latest/download/module.zip",
  "compatibility": {
    "minimum": "14",
    "verified": "14.367"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "6.0.0"
        }
      }
    ],
    "requires": [
      {
        "id": "dnd5e-combat",
        "type": "module",
        "compatibility": {
          "minimum": "0.146.0"
        }
      }
    ],
    "conflicts": [
      {
        "id": "bg3-hud-core",
        "type": "module",
        "reason": "The Bar replaces it: two action bars would be shown."
      },
      {
        "id": "combat-tracker-dock",
        "type": "module",
        "reason": "The Strip replaces it: two turn orders would be shown."
      },
      {
        "id": "party-monitor-dock",
        "type": "module",
        "reason": "The Party replaces it: two portrait columns would be shown."
      }
    ]
  },
  "esmodules": [
    "scripts/darsh-dnd-ui.mjs"
  ],
  "styles": [
    "styles/darsh-dnd-ui.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    }
  ]
}
